# Copy to .env.local for Next.js local dev
OPENAI_API_KEY=sk-xxxx

# UI defaults (client-exposed)
# 食数(人数)のデフォルト値（正の整数）
NEXT_PUBLIC_DEFAULT_SERVINGS=2
# 1日の予算のデフォルト値（例: 1500円）
NEXT_PUBLIC_DEFAULT_BUDGET=
# アレルギー/除外食材（例: 卵, 乳）
NEXT_PUBLIC_DEFAULT_ALLERGIES=
# 苦手な料理/好み（例: 辛いものを避ける、魚多め）
NEXT_PUBLIC_DEFAULT_DISLIKES=
# 1食の目安時間（例: 20分）
NEXT_PUBLIC_DEFAULT_TIME_PER_MEAL=
